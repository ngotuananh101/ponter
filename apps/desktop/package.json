{
  "name": "@ponter/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ponter Desktop Application (Electron + Vue 3)",
  "homepage": "https://github.com/ngotuananh101/ponter",
  "author": "Ngo Tuan Anh <ngotuananh2101@gmail.com>",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test": "vitest run",
    "package:dir": "electron-builder --dir",
    "package": "electron-builder --publish never"
  },
  "dependencies": {
    "@lucide/vue": "^1.49.0",
    "@ponter/api-client": "workspace:*",
    "@ponter/shared": "workspace:*",
    "@ponter/ui-components": "workspace:*",
    "@ponter/webrtc-core": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.3.9",
    "pinia": "4.0.3",
    "reka-ui": "^2.10.5",
    "shadcn-vue": "^2.8.2",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.0",
    "happy-dom": "20.14.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.11"
  }
}
