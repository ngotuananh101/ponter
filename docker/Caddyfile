# Caddyfile — reverse proxy for the @ponter/server backend.
#
# Assumes this file is mounted at /etc/caddy/Caddyfile (see docker-compose.prod.yml).
# Caddy automatically provisions Let's Encrypt TLS certificates for the domain
# specified in ${DOMAIN} (resolved at Caddyfile load time).
#
# The web frontend (apps/web) is typically served separately on Cloudflare Pages;
# this Caddyfile terminates TLS and reverse-proxies all API / WebSocket traffic
# to the server container.

# Global options block (must be first, without any key)
{
	# ACME account email for Let's Encrypt certificates.
	# email you@example.com
}

# Site block: use DOMAIN from environment, fallback to localhost if unset
{$DOMAIN:localhost} {
	# Browser/agent WebSocket traffic gets its own upstream transport block.
	#
	# Caddy 2 proxies the Upgrade handshake transparently for every path, so the
	# matcher is not what makes WS work — the explicit block is about the two
	# knobs that decide whether a long-lived socket survives:
	#
	#   - `read_buffer 65536` sizes the per-connection read buffer so a burst of
	#     ICE candidates / terminal frames is not read one small chunk at a time.
	#   - `keepalive 300s` keeps the upstream connection pool entry warm; the
	#     server's keepalive pings every 30s, so a shorter idle timeout would
	#     reap a connection the server still believes is live.
	#
	# The path matcher (`/api/ws/*`) mirrors the two upgrade routes the server
	# actually serves (`/api/ws/agent`, `/api/ws/browser`).
	@ws path /api/ws/*
	reverse_proxy @ws server:8787 {
		transport http {
			read_buffer 65536
			keepalive 300s
		}
	}

	# Everything else (REST API) uses the default proxy transport.
	reverse_proxy server:8787
}
