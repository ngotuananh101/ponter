# Multi-stage build for the @ponter/server self-hosted backend.
#
# Stage layout:
#   base    - node:24-alpine with Corepack/pnpm boot-strapped.
#   builder - installs all deps (incl. dev) and compiles @ponter/server.
#   runner  - production runtime image; native deps pre-installed, dev deps stripped.

###############################################################################
# Stage 1: base — shared foundation for builder and runner
###############################################################################
FROM node:24-alpine AS base

# Make `pnpm` available globally via Corepack.
# COREPACK_ENABLE_DOWNLOAD_PROMPT=0 silences the first-run download prompt.
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV NODE_ENV=production

RUN corepack enable

###############################################################################
# Stage 2: builder — compile @ponter/server (needs full dep tree + native toolchain)
###############################################################################
FROM base AS builder

# Native build toolchain required to compile better-sqlite3 against the
# alpine musl libc. These are NOT carried into the runner stage.
RUN apk add --no-cache python3 make g++ gcc

WORKDIR /app

# Install dependencies. We copy the workspace manifest, lockfile, root
# tsconfig, and the shared + server packages so pnpm can resolve the workspace.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages/ ./packages/
COPY apps/server/ ./apps/server/

# `--offline` is omitted so pnpm can fetch any missing registry packages.
RUN pnpm install --frozen-lockfile

# Build @ponter/server. @ponter/shared is a pure type package (no build script)
# that ships source directly via "main": "./src/index.ts", so it needs no build step.
RUN pnpm --filter @ponter/server build

###############################################################################
# Stage 3: runner — production image
###############################################################################
FROM base AS runner

WORKDIR /app

# Native build toolchain required to compile better-sqlite3 in pnpm install --prod
# (Node.js 24 on Alpine musl has no prebuilt binary available upstream).
# `su-exec` is the privilege-drop helper the entrypoint uses: BusyBox's
# `setpriv` only handles capabilities (no --reuid/--regid) and util-linux is a
# heavy dependency for one flag set.
RUN apk add --no-cache python3 make g++ gcc su-exec

# Copy native deps needed at runtime.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/ ./packages/
COPY apps/server/package.json ./apps/server/

# Install only production deps (skip devDependencies, scripts, etc.).
RUN pnpm install --prod --frozen-lockfile

# Pull compiled output from the builder stage.
COPY --from=builder /app/apps/server/dist ./apps/server/dist
COPY --from=builder /app/packages/ ./packages/

# Create the data directory (VOLUME declares the mount point but does not
# create the directory tree that SQLite's parent must exist).
RUN mkdir -p /app/data && chown -R node:node /app/data

# The entrypoint takes ownership of the (possibly bind-mounted) data directory
# and then drops to `node`. It therefore starts as root — the server process
# itself still runs unprivileged. See docker/entrypoint.sh for the full
# reasoning; in short, a bind mount replaces the baked-in ownership, so a
# `./data` not owned by UID 1000 makes SQLite fail with SQLITE_CANTOPEN.
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Data directory for SQLite files.
VOLUME /app/data
ENV DATABASE_PATH=/app/data/remote.db
ENV PORT=8787

EXPOSE 8787

# The entrypoint drops privileges to `node` before exec'ing the server.
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["node", "apps/server/dist/index.js"]
