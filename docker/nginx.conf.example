# Nginx configuration example for Ponta Remote Backend (@remote/server).
#
# Place this file in /etc/nginx/sites-available/api.example.com
# and symlink to /etc/nginx/sites-enabled/:
#   sudo ln -s /etc/nginx/sites-available/api.example.com /etc/nginx/sites-enabled/
#
# Obtain SSL certificates with Certbot:
#   sudo certbot --nginx -d api.example.com
#
# Test and reload:
#   sudo nginx -t && sudo systemctl reload nginx

# Connection upgrade map for WebSocket support
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Redirect HTTP to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name api.example.com;

    return 301 https://$host$request_uri;
}

# HTTPS server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.example.com;

    # SSL certificates (managed by Certbot or custom)
    ssl_certificate /etc/letsencrypt/live/api.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.example.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    # Client payload size
    client_max_body_size 50M;

    location / {
        # Proxy to the Docker container bound on localhost:8787
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;

        # WebSocket headers (critical for /api/ws)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Standard proxy headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Keep alive and prevent WebSocket disconnect on idle
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_connect_timeout 60s;

        # Disable buffering for low-latency WebSocket signaling
        proxy_buffering off;
    }
}
