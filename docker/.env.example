# Environment variables for docker-compose.yml and docker-compose.coturn.yml.
#
# Copy this file to .env and fill in real values before running:
#   cp .env.example .env
#
# Generate strong secrets with:
#   openssl rand -base64 48   (for JWT / refresh secrets)
#   openssl rand -hex 16      (for TURN_SECRET — 32 hex chars minimum)

# ---------------------------------------------------------------------------
# Image & Port Configuration
# ---------------------------------------------------------------------------

# Published image from Docker Hub.
DOCKERHUB_IMAGE=ngotuananh2101/ponter

# Host port mapping for Nginx web and API front door (default 80).
# Example: PONTER_HTTP_PORT=80 or bind to localhost only: PONTER_HTTP_PORT=127.0.0.1:80
PONTER_HTTP_PORT=80

# Optional: override public API URL injected into frontend config.js.
# Leave empty for standard same-origin resolution (recommended).
PONTER_API_URL=

# ---------------------------------------------------------------------------
# Required Security Secrets
# ---------------------------------------------------------------------------

# Secret used to sign JWT access tokens (HS256). Minimum 32 characters.
JWT_SECRET=

# Secret used to sign JWT refresh tokens (HS256). Minimum 32 characters.
REFRESH_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# CORS Configuration
# ---------------------------------------------------------------------------

# Browser origins allowed to make cross-origin requests.
# Defaults to http://localhost for standard deployments.
CORS_ORIGIN=http://localhost

# ---------------------------------------------------------------------------
# Coturn Setup (docker-compose.coturn.yml only)
# ---------------------------------------------------------------------------

# Public domain name for Coturn realm and ICE candidate advertising.
DOMAIN=example.com

# Shared secret for Coturn long-term credential mechanism (RFC 5766).
TURN_SECRET=

# Optional: override advertised STUN/TURN URLs if clients must connect by IP:
# TURN_URL=turn:<your-server-ip>:3478
# STUN_URL=stun:<your-server-ip>:3478

# ---------------------------------------------------------------------------
# Cloudflare Calls TURN Provider (Optional Server Configuration)
# ---------------------------------------------------------------------------

# If using Cloudflare Calls TURN instead of local Coturn, set TURN_PROVIDER=cloudflare:
# TURN_PROVIDER=cloudflare
# TURN_KEY_ID=
# TURN_KEY_API_TOKEN=
