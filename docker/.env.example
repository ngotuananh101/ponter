# Environment variables for docker-compose.local.yml, docker-compose.tunnel.yml,
# and docker-compose.prod.yml.
#
# Copy this file to .env and fill in real values before running.
#   cp .env.example .env
#
# Generate strong secrets with, e.g.:
#   openssl rand -base64 48   (for JWT / refresh secrets)
#   openssl rand -hex 16      (for TURN_SECRET — 32 hex chars minimum)

# ---------------------------------------------------------------------------
# Server image — required for the tunnel, prod, and nginx setups
# ---------------------------------------------------------------------------

# The prebuilt image published by the Docker Publish workflow. Compose files
# pull this instead of building from source.
#
# The Docker Hub account is not the same identifier as the GitHub one, so this
# is the Docker Hub namespace, not the GitHub handle.
DOCKERHUB_IMAGE=ngotuananh2101/ponter

# Pin a specific build instead of tracking latest, e.g. .../ponter:sha-553d3cd.
# Leave as-is unless you need a reproducible rollback target.
# DOCKERHUB_IMAGE=ngotuananh2101/ponter:sha-553d3cd

# ---------------------------------------------------------------------------
# Shared secrets — required for tunnel and prod setups
# ---------------------------------------------------------------------------

# Secret used to sign JWT access tokens (HS256). Minimum 32 characters.
# generate: openssl rand -base64 48
JWT_SECRET=

# Secret used to sign JWT refresh tokens (HS256). Minimum 32 characters.
# generate: openssl rand -base64 48
REFRESH_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# CORS — which origins may make cross-origin requests to the API
# ---------------------------------------------------------------------------

# The browser origins allowed to call the API and open the WebSocket.
# Comma-separated. REQUIRED in production — a wildcard or an unset value makes
# the server refuse to start (the Origin header is the CSWSH defence).
# Local dev may leave this unset, or set it to your web dev origin:
CORS_ORIGIN=http://localhost:5173
# Tunnel / Prod: e.g. https://app.example.com

# ---------------------------------------------------------------------------
# Tunnel setup (docker-compose.tunnel.yml) — Cloudflare Tunnel
# ---------------------------------------------------------------------------

# A Cloudflare Tunnel token. Create a tunnel with:
#   cloudflared tunnel create my-tunnel
#   cloudflared tunnel token my-tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------------------
# Production setup (docker-compose.prod.yml) — domain + TURN
# ---------------------------------------------------------------------------

# Your domain. Caddy will request Let's Encrypt certificates for it and
# TURN will advertise it as its realm.
DOMAIN=example.com

# Shared secret for the Coturn TURN server (RFC 5766 long-term auth).
# The server uses this to mint time-limited HMAC-SHA1 credentials.
# Generate with: openssl rand -hex 32
TURN_SECRET=

# Optional: override the STUN/TURN URL advertised to clients. When unset,
# TURN_URL and STUN_URL fall back to turn:${DOMAIN}:3478 / stun:${DOMAIN}:3478.
#
# Set these when clients must reach the TURN server by IP instead of the
# domain — e.g. a DNS name that is not resolvable from every client network:
#   TURN_URL=turn:<your-server-ip>:3478
#   STUN_URL=stun:<your-server-ip>:3478
# STUN_URL=
# TURN_URL=

# ---------------------------------------------------------------------------
# TURN provider selection (server) — coturn (default) | cloudflare | none
# ---------------------------------------------------------------------------

# Which TURN provider the server advertises to browsers and agents.
#   coturn     (default) — self-hosted Coturn, RFC 5766 HMAC credentials from
#                          TURN_SECRET + TURN_URL. Unchanged from earlier phases.
#   cloudflare — hosted Cloudflare Calls TURN. Requires TURN_KEY_ID and
#                TURN_KEY_API_TOKEN. Credentials are minted via the Cloudflare
#                API and cached for their TTL; media relays through Cloudflare
#                (first 1,000 GB/month free, then ~$0.05/GB egress). See
#                docs/guides/deployment.md.
#   none       — STUN only (no relay). Peers behind symmetric NAT may fail.
# Leave unset to keep the coturn default.
# TURN_PROVIDER=coturn

# Cloudflare Calls TURN credentials — required only when TURN_PROVIDER=cloudflare.
# Create a TURN key in the Cloudflare dashboard (Realtime > TURN).
# TURN_KEY_ID=
# TURN_KEY_API_TOKEN=
